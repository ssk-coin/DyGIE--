{
  "transformer_model": "bert-base-cased",
  "max_span_width": 8,
  "max_total_length": 512,

  "use_ner":   true,
  "use_rel":   true,
  "use_coref": true,
  "coref_prop": 1,
  "_comment_coref_prop": "スパングラフ伝播の反復回数（DyGIE++ Section 3.3）。0 で無効、1 以上で coref_prop 回繰り返す。元論文の設定: 1。use_coref=false のときは無視される。",

  "ner_loss_weight":   1.0,
  "rel_loss_weight":   1.0,
  "coref_loss_weight": 1.0,
  "use_gold_spans_for_rel": true,

  "width_embedding_dim":  128,
  "feedforward_dim":      150,
  "use_attentive_pooling": true,
  "spans_per_word":       0.4,
  "max_top_antecedents":  50,
  "dropout":              0.4,

  "num_epochs":      20,
  "batch_size":       4,
  "lr_transformer": 2e-5,
  "lr_task":        1e-4,
  "warmup_steps":   200,
  "max_grad_norm":  1.0,
  "num_workers":      0,
  "log_every":       50,

  "seed": 42,
  "_comment_seed": "Python / NumPy / PyTorch の乱数シードを一括固定する。null または キーなし で固定しない。"
}
